# M2: extractor VLM qua API tương thích OpenAI. Copy thành .env (đã gitignore), không commit.
# Đặt giới hạn chi tiêu phía nhà cung cấp API trước khi chạy.
VLM_API_BASE=https://mkp-api.fptcloud.com
VLM_API_KEY=
VLM_MODEL=Qwen2.5-VL-7B-Instruct
# Giá USD / 1 triệu token, lấy từ trang giá của nhà cung cấp; để 0 thì báo cáo chi phí = 0
VLM_PRICE_IN=0
VLM_PRICE_OUT=0
# Để trống: gửi ảnh gốc (cấu hình của các số liệu đã công bố). deskew: xoay thẳng ảnh trước khi gửi
VLM_PREPROCESS=
# Agent điều tra (--agent). Để trống thì dùng VLM_*; model cần hỗ trợ tool calling
AGENT_API_BASE=
AGENT_API_KEY=
AGENT_MODEL=
# native: function calling chuẩn OpenAI (vLLM cần --enable-auto-tool-choice --tool-call-parser hermes)
# json: model trả {"tool", "args"} trong nội dung; dùng khi server không bật tool parser (vd FPT)
AGENT_TOOL_MODE=native
# Gemini làm LLM điều phối (endpoint tương thích OpenAI, có tool calling native). Key: https://aistudio.google.com/apikey
# AGENT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# AGENT_API_KEY=
# AGENT_MODEL=gemini-3.8-flash
# AGENT_TOOL_MODE=native
# Giới hạn lượt gọi LLM / phút phía client (Gemini free: 15). Để trống = không giới hạn
AGENT_RPM=
# Giá LLM điều phối, USD / 1 triệu token; để trống thì dùng VLM_PRICE_*
AGENT_PRICE_IN=
AGENT_PRICE_OUT=
