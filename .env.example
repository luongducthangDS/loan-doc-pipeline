# M2: extractor VLM qua API tương thích OpenAI. Copy thành .env (đã gitignore), không commit.
# Đặt giới hạn chi tiêu phía nhà cung cấp API trước khi chạy.
VLM_API_BASE=https://mkp-api.fptcloud.com
VLM_API_KEY=
VLM_MODEL=Qwen2.5-VL-7B-Instruct
# Giá USD / 1 triệu token, lấy từ trang giá của nhà cung cấp; để 0 thì báo cáo chi phí = 0
VLM_PRICE_IN=0
VLM_PRICE_OUT=0
